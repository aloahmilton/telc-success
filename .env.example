# ==========================================
# Target Domain Configuration
# ==========================================
SITE_URL="https://telcsuccess.org"

# ==========================================
# MongoDB Atlas Database Credentials
# ==========================================
# Set MONGODB_URI in your server environment variables or hosting panel.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.lrgq2kv.mongodb.net/telc_db?retryWrites=true&w=majority"

# ==========================================
# Google SMTP Automated Mailer Configuration
# ==========================================
# Use a Google App Password (not your personal password)
# Generate via Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password"
ADMIN_EMAIL="admin@telcsuccess.org"

# ==========================================
# Server & Production Configuration
# ==========================================
NODE_ENV="production"
PORT=3000
